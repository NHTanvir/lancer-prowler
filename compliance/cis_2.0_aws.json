{
  "Framework": "CIS AWS Foundations Benchmark",
  "Version": "2.0.0",
  "Provider": "aws",
  "Requirements": [
    {"Id": "1.4", "Description": "No root access key.", "Checks": ["iam_no_root_access_key"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "1.5", "Description": "Root MFA enabled.", "Checks": ["iam_root_mfa_enabled"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "1.6", "Description": "Hardware MFA for root.", "Checks": ["iam_root_hardware_mfa_enabled"], "Attributes": [{"Profile": "Level 2"}]},
    {"Id": "1.14", "Description": "Access key rotation 90 days.", "Checks": ["iam_rotate_access_key_90_days"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "2.1.1", "Description": "S3 default encryption.", "Checks": ["s3_bucket_default_encryption"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "2.1.4", "Description": "S3 bucket public access blocked.", "Checks": ["s3_account_level_public_access_blocks", "s3_bucket_level_public_access_block"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "3.1", "Description": "Multi-region CloudTrail.", "Checks": ["cloudtrail_multi_region_enabled"], "Attributes": [{"Profile": "Level 1"}]},
    {"Id": "3.2", "Description": "Log file validation.", "Checks": ["cloudtrail_log_file_validation_enabled"], "Attributes": [{"Profile": "Level 2"}]},
    {"Id": "3.7", "Description": "KMS encryption for CloudTrail.", "Checks": ["cloudtrail_kms_encryption_enabled"], "Attributes": [{"Profile": "Level 2"}]},
    {"Id": "3.8", "Description": "KMS CMK rotation.", "Checks": ["kms_cmk_rotation_enabled"], "Attributes": [{"Profile": "Level 2"}]},
    {"Id": "5.1", "Description": "EBS default encryption.", "Checks": ["ec2_ebs_default_encryption"], "Attributes": [{"Profile": "Level 1"}]}
  ]
}
