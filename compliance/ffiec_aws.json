{
  "Framework": "FFIEC IT Examination Handbook",
  "Version": "2021",
  "Provider": "aws",
  "Requirements": [
    {"Id": "AUTH.MFA", "Description": "Multi-factor authentication for privileged users.", "Checks": ["iam_root_mfa_enabled", "iam_user_mfa_enabled_console_access"], "Attributes": [{"Booklet": "Information Security"}]},
    {"Id": "PROT.ENC", "Description": "Encryption at rest and in transit.", "Checks": ["s3_bucket_default_encryption", "s3_bucket_secure_transport_policy", "rds_instance_encrypted"], "Attributes": [{"Booklet": "Information Security"}]},
    {"Id": "MON.AUDIT", "Description": "Audit and log management.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Booklet": "Information Security"}]},
    {"Id": "BCP.BAK", "Description": "Backup and recovery.", "Checks": ["rds_instance_backup_enabled", "s3_bucket_object_versioning"], "Attributes": [{"Booklet": "Business Continuity"}]}
  ]
}
