{
  "Framework": "KISA ISMS-P",
  "Version": "2023",
  "Provider": "aws",
  "Requirements": [
    {"Id": "2.1.1", "Description": "정책 수립.", "Checks": ["config_recorder_all_regions_enabled"], "Attributes": [{"Domain": "관리체계"}]},
    {"Id": "2.5.3", "Description": "사용자 인증 (MFA).", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled"], "Attributes": [{"Domain": "접근통제"}]},
    {"Id": "2.6.1", "Description": "암호화 적용.", "Checks": ["s3_bucket_default_encryption", "ec2_ebs_default_encryption", "rds_instance_encrypted"], "Attributes": [{"Domain": "암호화"}]},
    {"Id": "2.9.4", "Description": "로그 및 접속기록 관리.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Domain": "운영보안"}]}
  ]
}
