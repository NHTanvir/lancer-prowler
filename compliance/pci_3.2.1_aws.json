    {"Id": "3.4", "Description": "Render PAN unreadable wherever stored.", "Checks": ["s3_bucket_default_encryption", "s3_bucket_kms_encryption", "ec2_ebs_default_encryption", "rds_instance_encrypted"], "Attributes": [{"Section": "Requirement 3"}]},
    {"Id": "4.1", "Description": "Strong cryptography in transit.", "Checks": ["s3_bucket_secure_transport_policy", "elbv2_listener_uses_secure_ssl_policy"], "Attributes": [{"Section": "Requirement 4"}]},
    {"Id": "7.1", "Description": "Restrict access by business need to know.", "Checks": ["iam_inline_policy_no_administrative_privileges", "iam_policy_allows_privilege_escalation"], "Attributes": [{"Section": "Requirement 7"}]},
    {"Id": "8.3", "Description": "MFA required.", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled"], "Attributes": [{"Section": "Requirement 8"}]},
