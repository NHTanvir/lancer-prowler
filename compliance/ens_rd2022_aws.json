{
  "Framework": "Esquema Nacional de Seguridad (ENS)",
  "Version": "Real Decreto 311/2022",
  "Provider": "aws",
  "Requirements": [
    {"Id": "op.acc.1", "Description": "Identificación.", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled"], "Attributes": [{"Marco": "Operacional"}]},
    {"Id": "op.acc.5", "Description": "Mecanismos de autenticación.", "Checks": ["iam_password_policy_minimum_length_14", "iam_password_policy_symbol", "iam_password_policy_number"], "Attributes": [{"Marco": "Operacional"}]},
    {"Id": "mp.com.2", "Description": "Protección de la confidencialidad.", "Checks": ["s3_bucket_default_encryption", "s3_bucket_secure_transport_policy"], "Attributes": [{"Marco": "Medidas de Protección"}]},
    {"Id": "op.mon.1", "Description": "Detección de intrusión.", "Checks": ["guardduty_is_enabled", "vpc_flow_logs_enabled"], "Attributes": [{"Marco": "Operacional"}]},
    {"Id": "op.exp.8", "Description": "Registro de la actividad.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Marco": "Operacional"}]}
  ]
}
