{
  "Framework": "FedRAMP Moderate Baseline (NIST 800-53 rev4)",
  "Version": "rev4",
  "Provider": "aws",
  "Requirements": [
    {"Id": "AC-2", "Description": "Account Management.", "Checks": ["iam_user_mfa_enabled_console_access", "iam_rotate_access_key_90_days", "iam_user_two_active_access_key"], "Attributes": [{"Family": "Access Control"}]},
    {"Id": "AC-6", "Description": "Least Privilege.", "Checks": ["iam_inline_policy_no_administrative_privileges", "iam_policy_allows_privilege_escalation"], "Attributes": [{"Family": "Access Control"}]},
    {"Id": "AU-2", "Description": "Audit Events.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_cloudwatch_logging_enabled"], "Attributes": [{"Family": "Audit and Accountability"}]},
    {"Id": "AU-9", "Description": "Protection of Audit Information.", "Checks": ["cloudtrail_log_file_validation_enabled", "cloudtrail_logs_s3_bucket_is_not_publicly_accessible"], "Attributes": [{"Family": "Audit and Accountability"}]},
    {"Id": "IA-2", "Description": "MFA.", "Checks": ["iam_root_mfa_enabled", "iam_root_hardware_mfa_enabled", "iam_user_mfa_enabled_console_access"], "Attributes": [{"Family": "Identification and Authentication"}]},
    {"Id": "SC-13", "Description": "Cryptographic Protection.", "Checks": ["s3_bucket_default_encryption", "s3_bucket_kms_encryption", "ec2_ebs_default_encryption", "rds_instance_encrypted"], "Attributes": [{"Family": "System and Communications Protection"}]}
  ]
}
