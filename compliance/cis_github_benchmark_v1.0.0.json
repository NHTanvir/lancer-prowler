{
  "Framework": "CIS GitHub Benchmark",
  "Version": "1.0.0",
  "Provider": "github",
  "Requirements": [
    {
      "Id": "1.1.1",
      "Description": "Ensure 2FA is required for all organization members.",
      "Checks": ["organization_2fa_required"],
      "Attributes": [{"Section": "1", "SubSection": "1", "Profile": "Level 1"}]
    },
    {
      "Id": "1.1.2",
      "Description": "Ensure default member permission is least privilege.",
      "Checks": ["organization_default_member_permission_least_privilege"],
      "Attributes": [{"Section": "1", "SubSection": "2", "Profile": "Level 1"}]
    },
    {
      "Id": "2.1.1",
      "Description": "Ensure branch protection rules are configured for the default branch.",
      "Checks": ["repository_branch_protection_main"],
      "Attributes": [{"Section": "2", "SubSection": "1", "Profile": "Level 1"}]
    },
    {
      "Id": "2.1.2",
      "Description": "Ensure signed commits are required.",
      "Checks": ["repository_default_branch_signed_commits"],
      "Attributes": [{"Section": "2", "SubSection": "2", "Profile": "Level 2"}]
    },
    {
      "Id": "3.1.1",
      "Description": "Ensure GitHub Actions are pinned to commit SHAs.",
      "Checks": ["workflow_actions_pinned_to_sha"],
      "Attributes": [{"Section": "3", "SubSection": "1", "Profile": "Level 1"}]
    },
    {
      "Id": "3.1.2",
      "Description": "Ensure workflows have no hard-coded secrets.",
      "Checks": ["workflow_no_hardcoded_secrets"],
      "Attributes": [{"Section": "3", "SubSection": "2", "Profile": "Level 1"}]
    }
  ]
}
