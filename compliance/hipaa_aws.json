{
  "Framework": "HIPAA Security Rule",
  "Version": "Final Rule 2013",
  "Provider": "aws",
  "Requirements": [
    {"Id": "164.308(a)(3)", "Description": "Workforce security — access authorization.", "Checks": ["iam_inline_policy_no_administrative_privileges", "iam_policy_attached_only_to_group_or_roles"], "Attributes": [{"Section": "Administrative Safeguards"}]},
    {"Id": "164.308(a)(5)", "Description": "Security awareness — password management.", "Checks": ["iam_password_policy_minimum_length_14", "iam_password_policy_reuse_24", "iam_password_policy_expires_passwords_within_90_days_or_less"], "Attributes": [{"Section": "Administrative Safeguards"}]},
    {"Id": "164.312(a)(2)(iv)", "Description": "Encryption and decryption.", "Checks": ["s3_bucket_default_encryption", "ec2_ebs_default_encryption", "rds_instance_encrypted"], "Attributes": [{"Section": "Technical Safeguards"}]},
    {"Id": "164.312(b)", "Description": "Audit controls.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Section": "Technical Safeguards"}]},
    {"Id": "164.312(d)", "Description": "Person or entity authentication (MFA).", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled"], "Attributes": [{"Section": "Technical Safeguards"}]},
    {"Id": "164.312(e)(1)", "Description": "Transmission security.", "Checks": ["s3_bucket_secure_transport_policy", "elbv2_listener_uses_secure_ssl_policy"], "Attributes": [{"Section": "Technical Safeguards"}]}
  ]
}
