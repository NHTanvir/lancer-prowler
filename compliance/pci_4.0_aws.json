{
  "Framework": "PCI DSS",
  "Version": "4.0",
  "Provider": "aws",
  "Requirements": [
    {"Id": "1.2.1", "Description": "Network security control rules.", "Checks": ["ec2_securitygroup_allow_ingress_from_internet_to_any_port"], "Attributes": [{"Section": "Requirement 1"}]},
    {"Id": "1.4.1", "Description": "NSC implemented between trusted and untrusted networks.", "Checks": ["vpc_subnet_no_public_ip_by_default", "vpc_peering_routing_tables_with_least_privilege"], "Attributes": [{"Section": "Requirement 1"}]},
    {"Id": "3.5.1", "Description": "PAN rendered unreadable using strong cryptography.", "Checks": ["s3_bucket_default_encryption", "s3_bucket_kms_encryption", "ec2_ebs_default_encryption", "rds_instance_encrypted"], "Attributes": [{"Section": "Requirement 3"}]},
    {"Id": "4.2.1", "Description": "Strong cryptography for transmission.", "Checks": ["s3_bucket_secure_transport_policy", "elbv2_listener_uses_secure_ssl_policy"], "Attributes": [{"Section": "Requirement 4"}]},
    {"Id": "7.2.1", "Description": "Access control model defined.", "Checks": ["iam_inline_policy_no_administrative_privileges", "iam_policy_attached_only_to_group_or_roles"], "Attributes": [{"Section": "Requirement 7"}]},
    {"Id": "8.4.2", "Description": "MFA implemented for all non-console access.", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled", "iam_root_hardware_mfa_enabled"], "Attributes": [{"Section": "Requirement 8"}]},
    {"Id": "10.2.1", "Description": "Audit logs implemented.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Section": "Requirement 10"}]},
    {"Id": "11.5", "Description": "Detection of changes.", "Checks": ["config_recorder_all_regions_enabled", "guardduty_is_enabled"], "Attributes": [{"Section": "Requirement 11"}]}
  ]
}
