{
  "Framework": "ISO/IEC 27001",
  "Version": "2013",
  "Provider": "aws",
  "Requirements": [
    {"Id": "A.9.1.1", "Description": "Access control policy.", "Checks": ["iam_policy_attached_only_to_group_or_roles", "iam_inline_policy_no_administrative_privileges"], "Attributes": [{"Annex": "A.9"}]},
    {"Id": "A.9.4.2", "Description": "Secure log-on procedures (MFA).", "Checks": ["iam_user_mfa_enabled_console_access", "iam_root_mfa_enabled"], "Attributes": [{"Annex": "A.9"}]},
    {"Id": "A.10.1.1", "Description": "Policy on the use of cryptographic controls.", "Checks": ["s3_bucket_default_encryption", "kms_cmk_rotation_enabled"], "Attributes": [{"Annex": "A.10"}]},
    {"Id": "A.12.4.1", "Description": "Event logging.", "Checks": ["cloudtrail_multi_region_enabled", "cloudtrail_log_file_validation_enabled"], "Attributes": [{"Annex": "A.12"}]},
    {"Id": "A.13.1.1", "Description": "Network controls.", "Checks": ["ec2_securitygroup_allow_ingress_from_internet_to_any_port", "vpc_flow_logs_enabled"], "Attributes": [{"Annex": "A.13"}]}
  ]
}
